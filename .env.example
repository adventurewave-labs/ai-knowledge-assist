OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=...
LANGSMITH_API_KEY=...
LANGSMITH_PROJECT=aria-rag
LANGSMITH_TRACING=false
CHROMA_PERSIST_DIR=./chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2
LLM_MODEL=gpt-4o-mini
FALLBACK_LLM_MODEL=gemini-1.5-flash
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K=5

# Comma-separated list of allowed CORS origins (e.g. https://app.example.com,https://admin.example.com).
# When set, credentialed cross-origin requests are allowed. Leave empty to disable
# credentialed access (falls back to a wildcard origin without credentials).
CORS_ORIGINS=

# API key required on protected endpoints via the X-API-Key header.
# Leave empty to disable authentication (local development / tests only).
API_KEY=

# Path to the JSON file persisting ingest deduplication keys across restarts.
# Set to an empty string to keep dedup state in memory only.
DEDUP_STORE_PATH=./aria_dedup.json

# Log level for the structured JSON logger (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO
